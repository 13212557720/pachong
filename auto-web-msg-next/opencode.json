{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/glm-5.1",
  "instructions": ["AGENTS.md"],
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "skill": "allow",
    "bash": {
      "*": "ask",
      "pnpm install*": "allow",
      "pnpm dev*": "allow",
      "pnpm run build*": "allow",
      "pnpm run lint*": "allow",
      "pnpm run generate:*": "allow",
      "pnpm add*": "allow",
      "pnpm remove*": "allow",
      "python*": "allow",
      "pytest*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git add*": "allow",
      "git commit*": "ask",
      "git push*": "ask",
      "npx*": "allow",
      "node*": "allow",
      "ls*": "allow",
      "dir*": "allow",
      "Get-ChildItem*": "allow"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "watcher": {
    "ignore": ["node_modules/**", ".next/**", "dist/**", ".git/**", "py_backend/.venv/**"]
  }
}
